{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "virtual-tour-360",
  "compatibility_date": "2026-08-27",
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback answers /api and /t before the Worker ever runs.
    "run_worker_first": ["/api/*", "/t/*", "/i/*"]
  },
  "r2_buckets": [
    { "binding": "TOURS", "bucket_name": "virtual-tour-360" }
  ]
}
